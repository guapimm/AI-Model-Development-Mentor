      },
      "hint": { "zh": "轻量 vs 常规文档", "en": "lightweight vs standard docs" },
      "triggers": { "phase": ["design", "phase0"] }
    },
    {
      "id": "workflow.phase0",
      "module": "workflow",
      "headings": {
        "zh-CN": "阶段0强制输出：项目资源预估表",
        "en-US": "Phase-0 Mandatory Output: Project Resource Estimate Table"
      },
      "hint": { "zh": "阶段0 资源预估表", "en": "phase-0 resource estimate" },
      "triggers": { "phase": ["phase0"] }
    },
    {
      "id": "workflow.db",
      "module": "workflow",
      "headings": {
        "zh-CN": "二、数据库设计强制规范",
        "en-US": "2. Database Design Mandatory Spec"
      },
      "hint": { "zh": "表结构+索引", "en": "schema + indexes" },
      "triggers": { "phase": ["design"], "ext": [".sql"] }
    },
    {
      "id": "workflow.ui",
      "module": "workflow",
      "headings": {
        "zh-CN": "三、前端可视化定位协议",
        "en-US": "3. Front-End Visual Positioning Protocol"
