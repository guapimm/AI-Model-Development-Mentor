    {
      "id": "workflow.commit",
      "module": "workflow",
      "headings": {
        "zh-CN": "七、版本锚点",
        "en-US": "7. Version Anchoring"
      },
      "hint": { "zh": "里程碑 commit 信息", "en": "milestone commit message" },
      "triggers": { "intent": ["commit", "git commit"] }
