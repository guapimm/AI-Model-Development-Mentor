    {
      "id": "workflow.enhance",
      "module": "workflow",
      "headings": {
        "zh-CN": "五、需求发散与建议",
        "en-US": "5. Requirement Expansion & Suggestions"
      },
      "hint": { "zh": "功能增强建议卡", "en": "enhancement card" },
